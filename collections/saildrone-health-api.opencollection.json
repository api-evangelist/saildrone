{
  "opencollection": "1.0.0",
  "info": {
    "name": "Saildrone Mission Health API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Health",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Service Health",
            "type": "http"
          },
          "http": {
            "method": "GET",
