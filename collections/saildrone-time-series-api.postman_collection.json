      "item": [
        {
          "id": "4c2b6881-6393-4525-94f0-683096e4acd5",
          "name": "Get Mission Time Series",
          "request": {
            "name": "Get Mission Time Series",
            "description": {
              "content": "Retrieve time-series records for a specific drone/mission and dataset over a given window. Supports interval thinning, limits, and ascending/descending order.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "timeseries",
                ":mission"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "data_set",
                  "value": "<string>",
                  "description": "(Required) Which Saildrone dataset to return for this mission."
                },
                {
                  "disabled": false,
                  "key": "start_date",
                  "value": "<dateTime>",
                  "description": "(Required) ISO-8601 start date/time (inclusive)."
                },
                {
                  "disabled": false,
                  "key": "end_date",
                  "value": "<dateTime>",
                  "description": "(Required) ISO-8601 end date/time (inclusive)."
                },
                {
                  "disabled": false,
                  "key": "interval",
                  "value": "1",
                  "description": "Sampling interval in minutes between returned points (1 = no thinning)."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "1000",
                  "description": "Maximum records per response page."
                },
                {
                  "disabled": false,
                  "key": "order_by",
                  "value": "asc",
                  "description": "Sort order for gps_time."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "mission",
                  "description": "(Required) Drone / mission identifier (e.g. 1023, 1039, 1040)."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
